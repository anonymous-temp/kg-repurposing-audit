{
    "$defs": {
        "ActionabilityConstraint": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "domain": {
                    "$ref": "#/$defs/Domain"
                },
                "evidence_ids": {
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "rationale": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "status": {
                    "$ref": "#/$defs/ConstraintStatus"
                }
            },
            "required": [
                "domain",
                "status"
            ],
            "title": "ActionabilityConstraint",
            "type": "object"
        },
        "AgentType": {
            "description": "Values of biolink AgentTypeEnum.",
            "enum": [
                "manual_agent",
                "automated_agent",
                "data_analysis_pipeline",
                "computational_model",
                "text_mining_agent",
                "manual_validation_of_automated_agent",
                "not_provided"
            ],
            "title": "AgentType",
            "type": "string"
        },
        "CandidatePrediction": {
            "additionalProperties": false,
            "description": "Provenance of a model score. Its knowledge level is always 'prediction' and its agent type 'computational_model'; a score is not evidence of efficacy.",
            "properties": {
                "candidate_count": {
                    "type": "integer"
                },
                "candidate_universe": {
                    "description": "The set of pairs the rank was computed over",
                    "type": "string"
                },
                "graph": {
                    "type": "string"
                },
                "model": {
                    "type": "string"
                },
                "rank": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "rank_scope": {
                    "type": "string"
                },
                "score": {
                    "type": "number"
                },
                "score_is_probability": {
                    "type": "boolean"
                },
                "seed": {
                    "type": "integer"
                },
                "source_sha256": {
                    "type": "string"
                },
                "task": {
                    "type": "string"
                },
                "write_back_policy": {
                    "$ref": "#/$defs/WriteBackPolicy"
                }
            },
            "required": [
                "model",
                "graph",
                "task",
                "candidate_universe",
                "write_back_policy",
                "seed",
                "score",
                "rank_scope",
                "candidate_count",
                "source_sha256",
                "score_is_probability"
            ],
            "title": "CandidatePrediction",
            "type": "object"
        },
        "ClinicalApprovalStatus": {
            "description": "Values of biolink ClinicalApprovalStatusEnum.",
            "enum": [
                "approved_for_condition",
                "fda_approved_for_condition",
                "not_approved_for_condition",
                "post_approval_withdrawal",
                "off_label_use",
                "not_provided"
            ],
            "title": "ClinicalApprovalStatus",
            "type": "string"
        },
        "ConstraintStatus": {
            "description": "",
            "enum": [
                "pass",
                "concern",
                "fail",
                "unknown"
            ],
            "title": "ConstraintStatus",
            "type": "string"
        },
        "DiscontinuationEvent": {
            "description": "",
            "enum": [
                "stopped_trial",
                "development_discontinuation",
                "market_withdrawal",
                "corporate_event"
            ],
            "title": "DiscontinuationEvent",
            "type": "string"
        },
        "Domain": {
            "description": "",
            "enum": [
                "mechanism",
                "systemic_exposure",
                "tissue_exposure",
                "regimen",
                "population",
                "comparator_endpoint",
                "safety",
                "evidence_path"
            ],
            "title": "Domain",
            "type": "string"
        },
        "EffectEstimate": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "estimate": {
                    "type": "number"
                },
                "lower": {
                    "type": "number"
                },
                "measure": {
                    "type": "string"
                },
                "upper": {
                    "type": "number"
                }
            },
            "required": [
                "measure",
                "estimate",
                "lower",
                "upper"
            ],
            "title": "EffectEstimate",
            "type": "object"
        },
        "EvidenceAssertion": {
            "additionalProperties": false,
            "description": "A dated statement from an identified source about the drug-disease pair.",
            "properties": {
                "clinical_approval_status": {
                    "$ref": "#/$defs/ClinicalApprovalStatus"
                },
                "effect": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/EffectEstimate"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "id": {
                    "type": "string"
                },
                "negated": {
                    "type": [
                        "boolean",
                        "null"
                    ]
                },
                "predicate": {
                    "$ref": "#/$defs/EvidencePredicate"
                },
                "proposition": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "research_phase": {
                    "$ref": "#/$defs/ResearchPhase"
                },
                "source": {
                    "type": "string"
                },
                "source_date": {
                    "format": "date",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "id",
                "source"
            ],
            "title": "EvidenceAssertion",
            "type": "object"
        },
        "EvidencePredicate": {
            "description": "",
            "enum": [
                "treats",
                "in_clinical_trials_for",
                "studied_to_treat",
                "contraindicated_in"
            ],
            "title": "EvidencePredicate",
            "type": "string"
        },
        "EvidenceScope": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "comparator": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "drug": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "endpoint": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "indication": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "population": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "regimen": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "title": "EvidenceScope",
            "type": "object"
        },
        "FailureAnnotation": {
            "additionalProperties": false,
            "description": "A discontinuation event (usually a stopped trial) and what it may change. The failure type is derived from the stop-reason categories; the implication follows the write-back rule in kg_audit.failures.implication.",
            "properties": {
                "category_source": {
                    "description": "Classifier or curator that assigned the categories, with version",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "event_type": {
                    "$ref": "#/$defs/DiscontinuationEvent"
                },
                "evidence_ids": {
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "failure_type": {
                    "$ref": "#/$defs/FailureType"
                },
                "implication": {
                    "$ref": "#/$defs/Implication"
                },
                "recorded_indication": {
                    "description": "True when the pair is already a recorded indication in the graph",
                    "type": [
                        "boolean",
                        "null"
                    ]
                },
                "registry_status": {
                    "$ref": "#/$defs/TrialStatus"
                },
                "scope": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/EvidenceScope"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "scope_match": {
                    "$ref": "#/$defs/ScopeMatch"
                },
                "source_date": {
                    "format": "date",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "stop_reason_categories": {
                    "items": {
                        "$ref": "#/$defs/StopReasonCategory"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "stop_reason_text": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "trial_condition": {
                    "description": "Condition CURIE as registered or as mapped by the source",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "trial_id": {
                    "description": "Registry identifier, e.g. NCT01234567; required when event_type is stopped_trial",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "trial_phase": {
                    "$ref": "#/$defs/ResearchPhase"
                },
                "trial_start_date": {
                    "format": "date",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "event_type",
                "failure_type",
                "scope_match",
                "implication"
            ],
            "title": "FailureAnnotation",
            "type": "object"
        },
        "FailureType": {
            "description": "",
            "enum": [
                "efficacy",
                "safety",
                "operational",
                "design",
                "uninformative",
                "success",
                "not_reported"
            ],
            "title": "FailureType",
            "type": "string"
        },
        "Implication": {
            "description": "",
            "enum": [
                "negate",
                "qualify",
                "retain",
                "defer"
            ],
            "title": "Implication",
            "type": "string"
        },
        "KnowledgeLevel": {
            "description": "Values of biolink KnowledgeLevelEnum.",
            "enum": [
                "knowledge_assertion",
                "logical_entailment",
                "prediction",
                "statistical_association",
                "observation",
                "not_provided"
            ],
            "title": "KnowledgeLevel",
            "type": "string"
        },
        "ResearchPhase": {
            "description": "Values of biolink ResearchPhaseEnum.",
            "enum": [
                "pre_clinical_research_phase",
                "clinical_trial_phase_1",
                "clinical_trial_phase_1_to_2",
                "clinical_trial_phase_2",
                "clinical_trial_phase_2_to_3",
                "clinical_trial_phase_3",
                "clinical_trial_phase_4",
                "not_provided"
            ],
            "title": "ResearchPhase",
            "type": "string"
        },
        "ScopeMatch": {
            "description": "",
            "enum": [
                "same_concept",
                "narrower_concept",
                "broader_concept",
                "unmapped"
            ],
            "title": "ScopeMatch",
            "type": "string"
        },
        "StopReasonCategory": {
            "description": "Razuvayevskaya et al. 2024 (17 classes) plus the Open Targets 'Uncategorised' label.",
            "enum": [
                "Another_Study",
                "Business_Administrative",
                "Covid19",
                "Endpoint_Met",
                "Ethical_Reason",
                "Insufficient_Data",
                "Insufficient_Enrollment",
                "Interim_Analysis",
                "Invalid_Reason",
                "Logistics_Resources",
                "Negative",
                "No_Context",
                "Regulatory",
                "Safety_Sideeffects",
                "Study_Design",
                "Study_Staff_Moved",
                "Success",
                "Uncategorised"
            ],
            "title": "StopReasonCategory",
            "type": "string"
        },
        "TreatmentStrategy": {
            "additionalProperties": false,
            "description": "A drug-indication hypothesis under review, qualified by population, regimen, comparator and endpoint. Completeness is assessed separately from structural validity.",
            "properties": {
                "agent_type": {
                    "$ref": "#/$defs/AgentType"
                },
                "assessment_date": {
                    "format": "date",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "comparator": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "constraints": {
                    "items": {
                        "$ref": "#/$defs/ActionabilityConstraint"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "drug": {
                    "description": "CURIE of the drug (e.g. DRUGBANK:DB01097)",
                    "type": "string"
                },
                "endpoint": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "evidence": {
                    "items": {
                        "$ref": "#/$defs/EvidenceAssertion"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "failures": {
                    "items": {
                        "$ref": "#/$defs/FailureAnnotation"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "id": {
                    "type": "string"
                },
                "indication": {
                    "description": "CURIE of the disease",
                    "type": "string"
                },
                "knowledge_level": {
                    "$ref": "#/$defs/KnowledgeLevel"
                },
                "population": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "prediction": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/CandidatePrediction"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "regimen": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "required_exposure": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "id",
                "drug",
                "indication"
            ],
            "title": "TreatmentStrategy",
            "type": "object"
        },
        "TrialStatus": {
            "description": "Subset of biolink ClinicalTrialStatusEnum used for stopped trials.",
            "enum": [
                "TERMINATED",
                "WITHDRAWN",
                "SUSPENDED"
            ],
            "title": "TrialStatus",
            "type": "string"
        },
        "WriteBackPolicy": {
            "description": "",
            "enum": [
                "no_writeback",
                "flat_negative",
                "mask_all",
                "typed",
                "typed_scoped"
            ],
            "title": "WriteBackPolicy",
            "type": "string"
        }
    },
    "$id": "https://github.com/anonymous-temp/kg-repurposing-audit/schema",
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "additionalProperties": true,
    "description": "A drug-indication hypothesis under review, qualified by population, regimen, comparator and endpoint. Completeness is assessed separately from structural validity.",
    "metamodel_version": "1.11.0",
    "properties": {
        "agent_type": {
            "$ref": "#/$defs/AgentType"
        },
        "assessment_date": {
            "format": "date",
            "type": [
                "string",
                "null"
            ]
        },
        "comparator": {
            "type": [
                "string",
                "null"
            ]
        },
        "constraints": {
            "items": {
                "$ref": "#/$defs/ActionabilityConstraint"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "drug": {
            "description": "CURIE of the drug (e.g. DRUGBANK:DB01097)",
            "type": "string"
        },
        "endpoint": {
            "type": [
                "string",
                "null"
            ]
        },
        "evidence": {
            "items": {
                "$ref": "#/$defs/EvidenceAssertion"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "failures": {
            "items": {
                "$ref": "#/$defs/FailureAnnotation"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "id": {
            "type": "string"
        },
        "indication": {
            "description": "CURIE of the disease",
            "type": "string"
        },
        "knowledge_level": {
            "$ref": "#/$defs/KnowledgeLevel"
        },
        "population": {
            "type": [
                "string",
                "null"
            ]
        },
        "prediction": {
            "anyOf": [
                {
                    "$ref": "#/$defs/CandidatePrediction"
                },
                {
                    "type": "null"
                }
            ]
        },
        "regimen": {
            "type": [
                "string",
                "null"
            ]
        },
        "required_exposure": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "required": [
        "id",
        "drug",
        "indication"
    ],
    "title": "kg_repurposing_evidence_handoff",
    "type": "object",
    "version": "0.3.0"
}
